extends ../common/templates/layout.pug

block prepend content
  - var title = "ts status"
  - var text = "users online"

block scripts 
  script(
      src="ts-status.ts"
      type="module"
  )
  link(
    href="ts-status.scss"
    rel="stylesheet"
  )
  link(
    rel="manifest"
    href="manifest.webmanifest"
  )

block heading
  h1
    live-value -

block append subcontainer
  p.hint connect via 0x29a.me:4711
  
block append text
  +iconButton("fa-solid fa-microphone", "connect")#connectButton
  +iconButton("fa-solid fa-refresh", "refresh")#refreshButton
  +iconButton("fa-regular fa-copy", "copy")#copyButton
  +iconButton("fa-solid fa-list", "userlist")#listButton
    
block append content 
  +modal("userlist", "userlist")
    ul.player-list
